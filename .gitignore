# Visual Studio user specific files
.vs/
.vsconfig

# JetBrains Rider
.idea/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa
Output
Engine/x64
Client/x64

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/

# Cache files for the editor to use
DerivedDataCache/*

# Prerequisites
*.d

# Python (Tools/ 자동화 스크립트)
__pycache__/
*.py[cod]
Tools/mcp/.venv/

# AnimGraph MCP 회귀 생성물 — 각 phase 테스트의 --recheck 비교 상태와 run_all.py 결과 (매 실행 재생성)
Tools/mcp/*_state.json
Tools/mcp/results/

# UI 자동 생성 파이프라인 (Docs/Design/ui-autogen-pipeline.md §3-2) — run 산출물 · 지표 · run 애셋은 커밋하지 않는다
Tools/uigen/work/
Tools/uigen/metrics/
Content/_AutoGen/

# AssetPipeline PoC 증거 묶음 (AssetPipeline_Docs/docs/review/ARCHITECTURE_v0.2_DRAFT.md §5.4) — .blend · FBX · 렌더 · 덤프가 1 GB 넘는다.
# 이 PC 에만 둔다(파일별 해시는 각 묶음의 manifest.json). 주의: .mcp.json 의 asset-blender 는 poc4a 묶음 안의 스크립트를 띄운다
AssetPipeline/poc/

# Claude Code — 개인 설정 (팀 공유 설정은 .claude/settings.json)
.claude/settings.local.json
.claude/.cache/
