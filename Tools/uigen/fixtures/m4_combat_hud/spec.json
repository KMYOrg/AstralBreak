{
  "schema_version": 1,
  "note": "Phase 1a 손 spec — M4 전투 HUD(설계 §5). 배치 · 색 · 크기는 잠정. bbox_intent 는 1920×1080 에서의 의도 좌표 [x, y, w, h] — 박스 안 칸은 fill 비율로 나누고, 글자는 칸 안에서 세로 가운데(v_align center). 글자 bbox 높이 = 줄 높이(엔진 기본 글꼴 — 크기 × 약 1.6, 칸보다 크면 칸 높이: 1a-4 실측 16→26 · 18→29 · 26→42 · 30→48 · 34→50(칸)).",
  "canvas": [1920, 1080],
  "profile": "hud",
  "root": "Root",
  "widgets": [
    { "id": "Root", "type": "CanvasPanel" },

    { "id": "UltArea", "type": "Overlay", "parent": "Root",
      "slot": { "kind": "canvas", "anchors": [0.5, 1, 0.5, 1], "alignment": [0.5, 1], "position": [0, -64], "size": [460, 44], "z": 1 },
      "bbox_intent": [730, 972, 460, 44] },
    { "id": "UltReadyGlow", "type": "Image", "parent": "UltArea",
      "slot": { "kind": "overlay", "h_align": "fill", "v_align": "fill" },
      "bbox_intent": [730, 972, 460, 44],
      "style": { "brush": { "draw_as": "image", "asset": "ult_glow" } },
      "binding": { "data": "ult_ready", "kind": "flag" } },
    { "id": "UltGauge", "type": "ProgressBar", "parent": "UltArea",
      "slot": { "kind": "overlay", "padding": [12, 10, 12, 10], "h_align": "fill", "v_align": "fill" },
      "bbox_intent": [742, 982, 436, 24],
      "style": {
        "background": { "draw_as": "box", "asset": "ult_frame", "margin": [0.08, 0.32, 0.08, 0.32] },
        "fill": { "draw_as": "rounded_box", "color": "#E8B54A", "radius": 6 },
        "fill_color": "#FFFFFF",
        "percent": 0.7,
        "bar_fill_type": "left_to_right"
      },
      "binding": { "data": "ult_gauge", "kind": "progress" } },

    { "id": "UltBlockedText", "type": "TextBlock", "parent": "Root",
      "slot": { "kind": "canvas", "anchors": [0.5, 1, 0.5, 1], "alignment": [0.5, 1], "position": [0, -116], "size": [240, 32], "z": 2 },
      "bbox_intent": [840, 932, 240, 32],
      "text": { "source": "static", "value": "오의 불가" },
      "font": { "size": 22, "weight": "bold", "color": "#FF6B5E" },
      "justification": "center",
      "binding": { "data": "ult_blocked", "kind": "flag" } },

    { "id": "ChainPanel", "type": "Border", "parent": "Root",
      "slot": { "kind": "canvas", "anchors": [1, 0, 1, 0], "alignment": [1, 0], "position": [-48, 140], "size": [260, 132], "z": 1 },
      "bbox_intent": [1612, 140, 260, 132],
      "style": { "brush": { "draw_as": "box", "asset": "chain_panel_bg", "margin": [0.05, 0.1, 0.05, 0.1] } },
      "binding": { "data": "chain_panel", "kind": "flag" } },
    { "id": "ChainBox", "type": "VerticalBox", "parent": "ChainPanel",
      "slot": { "kind": "border", "padding": [16, 10, 16, 12], "h_align": "fill", "v_align": "fill" },
      "bbox_intent": [1628, 150, 228, 110] },
    { "id": "ChainTitleText", "type": "TextBlock", "parent": "ChainBox",
      "slot": { "kind": "vertical_box", "size_rule": "fill", "fill": 3, "h_align": "fill", "v_align": "center" },
      "bbox_intent": [1628, 152, 228, 26],
      "text": { "source": "static", "value": "체인" },
      "font": { "size": 16, "weight": "bold", "color": "#C9B27C" },
      "justification": "center" },
    { "id": "ChainTimerText", "type": "TextBlock", "parent": "ChainBox",
      "slot": { "kind": "vertical_box", "size_rule": "fill", "fill": 5, "h_align": "fill", "v_align": "center" },
      "bbox_intent": [1628, 180, 228, 50],
      "text": { "source": "dynamic", "data": "chain_remaining", "sample": "4.2" },
      "font": { "size": 34, "weight": "bold", "color": "#FFF3D6" },
      "justification": "center",
      "binding": { "data": "chain_remaining", "kind": "number", "format": "0.0" } },
    { "id": "ChainCountText", "type": "TextBlock", "parent": "ChainBox",
      "slot": { "kind": "vertical_box", "size_rule": "fill", "fill": 3, "h_align": "fill", "v_align": "center" },
      "bbox_intent": [1628, 230.5, 228, 29],
      "text": { "source": "dynamic", "data": "chain_count", "sample": "2/4" },
      "font": { "size": 18, "weight": "regular", "color": "#E6DCC3" },
      "justification": "center",
      "binding": { "data": "chain_count", "kind": "text" } },

    { "id": "BurstBanner", "type": "Border", "parent": "Root",
      "slot": { "kind": "canvas", "anchors": [0.5, 0, 0.5, 0], "alignment": [0.5, 0], "position": [0, 96], "size": [420, 72], "z": 3 },
      "bbox_intent": [750, 96, 420, 72],
      "style": { "brush": { "draw_as": "rounded_box", "color": "#2A1A0ACC", "radius": 10, "outline_color": "#E8B54A", "outline_width": 2 } },
      "binding": { "data": "burst_banner", "kind": "flag" } },
    { "id": "BurstRow", "type": "HorizontalBox", "parent": "BurstBanner",
      "slot": { "kind": "border", "padding": [30, 8, 30, 8], "h_align": "fill", "v_align": "fill" },
      "bbox_intent": [780, 104, 360, 56] },
    { "id": "BurstLabelText", "type": "TextBlock", "parent": "BurstRow",
      "slot": { "kind": "horizontal_box", "size_rule": "fill", "fill": 2, "h_align": "fill", "v_align": "center" },
      "bbox_intent": [780, 111, 240, 42],
      "text": { "source": "static", "value": "체인 버스트" },
      "font": { "size": 26, "weight": "bold", "color": "#FFD27A" },
      "justification": "center" },
    { "id": "BurstCountText", "type": "TextBlock", "parent": "BurstRow",
      "slot": { "kind": "horizontal_box", "size_rule": "fill", "fill": 1, "h_align": "fill", "v_align": "center" },
      "bbox_intent": [1020, 108, 120, 48],
      "text": { "source": "dynamic", "data": "burst_count", "sample": "3" },
      "font": { "size": 30, "weight": "bold", "color": "#FFFFFF" },
      "justification": "center",
      "binding": { "data": "burst_count", "kind": "number", "format": "0" } }
  ],
  "assets": [
    { "asset_id": "ult_frame", "kind": "frame", "provenance": "procedural", "size": [200, 50], "nine_slice": true,
      "margin": [0.08, 0.32, 0.08, 0.32],
      "procedural": { "shape": "rounded_frame", "radius": 12, "border_px": 3, "border_color": "#E8B54A", "fill_color": "#1A140CD9",
                      "highlight_color": "#FFF0C070" } },
    { "asset_id": "chain_panel_bg", "kind": "panel_bg", "provenance": "procedural", "size": [320, 160], "nine_slice": true,
      "margin": [0.05, 0.1, 0.05, 0.1],
      "procedural": { "shape": "gradient_panel", "radius": 13, "border_px": 2, "border_color": "#C9A45C",
                      "top_color": "#2A2233E6", "bottom_color": "#140F1AE6" } },
    { "asset_id": "ult_glow", "kind": "ornament", "provenance": "procedural", "size": [256, 32],
      "procedural": { "shape": "soft_glow", "color": "#FFD27A", "falloff": 0.6 } }
  ],
  "allow_overlap": [],
  "locked": []
}
