{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uigen:brief",
  "title": "uigen brief v1 (설계 §4-2)",
  "description": "normalize 의 출력(1a 는 손으로 쓴 픽스처 — mode hand_spec). run_id 는 run 이 복사할 때 채운다.",
  "type": "object",
  "required": ["schema_version", "mode", "screen_type", "screen_id", "resolution", "required_elements", "dynamic_data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^R\\d{8}_\\d{6}_[A-Za-z0-9]+$" },
    "mode": { "enum": ["concept", "text", "multi_ref", "hand_spec"] },
    "screen_type": { "enum": ["hud", "menu", "options", "dialog", "cell"] },
    "button": { "$ref": "#/$defs/button" },
    "screen_id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,47}$" },
    "resolution": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 },
    "language": { "type": "string" },
    "font": { "type": ["string", "null"] },
    "required_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "urn:uigen:spec#/$defs/widget_id" },
          "kind": { "type": "string" },
          "desc": { "type": "string" }
        }
      }
    },
    "dynamic_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "widget"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "type": { "enum": ["text", "number", "progress", "flag", "image"] },
          "widget": { "$ref": "urn:uigen:spec#/$defs/widget_id" },
          "widget_type": { "$ref": "#/$defs/widget_type" },
          "format": { "type": "string" },
          "sample": {},
          "desc": { "type": "string" },
          "inside": { "$ref": "urn:uigen:spec#/$defs/widget_id" },
          "radial": { "$ref": "#/$defs/radial" },
          "bar": { "$ref": "#/$defs/bar" },
          "outline": { "$ref": "#/$defs/text_outline" },
          "font": { "$ref": "#/$defs/text_font" }
        }
      }
    },
    "static_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["widget", "value"],
        "additionalProperties": false,
        "properties": { "widget": { "$ref": "urn:uigen:spec#/$defs/widget_id" }, "value": { "type": "string" }, "outline": { "$ref": "#/$defs/text_outline" }, "font": { "$ref": "#/$defs/text_font" } }
      }
    },
    "style_keywords": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "role_source": { "enum": ["user", "auto"] },
          "reason": { "type": "string" }
        }
      }
    },
    "conflicts": { "type": "array", "items": { "type": "object" } },
    "binding_contract": {
      "type": "object",
      "required": ["class", "source", "bindings"],
      "additionalProperties": false,
      "properties": {
        "class": { "type": "string", "pattern": "^U[A-Z][A-Za-z0-9]*$" },
        "source": { "enum": ["new", "existing"] },
        "bindings": { "type": "array", "items": { "$ref": "urn:uigen:spec#/$defs/widget_id" } }
      }
    },
    "text": { "type": "string" },
    "note": { "type": "string" }
  },
  "$defs": {
    "button": {
      "description": "버튼 칸(Phase 3-2) — art = 기본 그림 위젯 id(칸 전체), label = 글자 위젯 id(data 의 text 하나), theme = config/theme_<id>.yaml. 구조가 요청으로 다 정해져 analyze 가 LLM 없이 짓는다",
      "type": "object", "required": ["art", "label", "theme"], "additionalProperties": false,
      "properties": { "art": { "$ref": "urn:uigen:spec#/$defs/widget_id" }, "label": { "$ref": "urn:uigen:spec#/$defs/widget_id" }, "theme": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
    },
    "radial": {
      "description": "progress 데이터가 Image 일 때 — 원형 닦기(spec brush.wipe). 중심 · 자리는 컨셉에서 잰다",
      "type": "object", "required": ["mode"], "additionalProperties": false,
      "properties": { "mode": { "enum": ["clockwise", "mirror"] }, "track_alpha": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "bar": {
      "description": "progress 데이터가 ProgressBar 일 때 — 모양 막대(메인 HUD, 11-24): 막대 하나 = 컨셉에서 오린 텍스처 한 장, 빈 자리 = 같은 텍스처를 track 색으로 물들인 배경. 자리 · 모양은 컨셉에서 잰다(gen/silhouette). 컨셉은 막대를 가득 찬 상태로 그린다(sample 1)",
      "type": "object", "additionalProperties": false,
      "properties": { "track": { "$ref": "urn:uigen:spec#/$defs/color" } }
    },
    "text_outline": {
      "description": "요청이 정한 글자 외곽선(컨셉에서 재지 않는다 — 글자 맞춤 · 스타일 · fix 가 못 건드림)",
      "type": "object", "required": ["size", "color"], "additionalProperties": false,
      "properties": { "size": { "type": "integer", "minimum": 1, "maximum": 8 }, "color": { "$ref": "urn:uigen:spec#/$defs/color" } }
    },
    "text_font": {
      "description": "글꼴로 그린 글자 참고판(make_concept --draw)이 정한 글꼴 값 — normalize 가 채운다. 그림을 다시 재지 않는다(글자 맞춤 · 스타일 · fix 가 못 건드림)",
      "type": "object", "required": ["size", "weight", "color"], "additionalProperties": false,
      "properties": { "size": { "type": "integer", "minimum": 1 }, "weight": { "enum": ["regular", "medium", "semibold", "bold", "extrabold"] }, "color": { "$ref": "urn:uigen:spec#/$defs/color" } }
    },
    "widget_type": {
      "description": "바인딩 위젯의 클래스 — codegen 계약(BindWidget 타입)이 정해지므로 concept 모드는 요청이 고정한다(1b-4)",
      "enum": ["CanvasPanel", "Overlay", "VerticalBox", "HorizontalBox", "UniformGridPanel", "SizeBox", "Border", "Image", "TextBlock", "ProgressBar", "Button", "Spacer"]
    }
  }
}
