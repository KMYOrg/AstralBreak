{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uigen:fixes",
  "title": "uigen fixes v1 (설계 §8-3) — verifier 의 수정 제안. 합격 판정에는 쓰지 않는다. fix 단계가 spec patch 로 바꾼다",
  "type": "object",
  "required": ["schema_version", "fixes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "enum": ["deterministic", "llm"] },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["widget", "problem"],
        "additionalProperties": false,
        "properties": {
          "widget": { "type": "string" },
          "problem": { "type": "string" },
          "gate": { "type": "string" },
          "evidence": { "type": "string" },
          "suggested_op": { "type": "object" }
        }
      }
    }
  }
}
