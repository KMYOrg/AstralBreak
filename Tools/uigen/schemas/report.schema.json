{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uigen:report",
  "title": "uigen report v1 (설계 §4-5) — verify · finalize 출력",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "attempt", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "parent_run_id": { "type": ["string", "null"] },
    "status": { "enum": ["pass", "fail", "incomplete", "quota", "error"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pass"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "value": {},
          "threshold": {},
          "pass": { "type": "boolean" },
          "skipped": { "type": "string", "description": "검사하지 않은 이유(예: procedural 에셋은 OCR 해당 없음) — pass 는 true" },
          "details": {}
        }
      }
    },
    "recorded": { "type": "object" },
    "fixes": { "type": "array" },
    "unsupported": { "type": "array" },
    "durations_s": { "type": "object", "additionalProperties": { "type": "number" } },
    "attempts": {
      "type": "array",
      "description": "verify 시도마다 한 줄 — 쓴 spec · build · 실패 게이트 · 정정 patch · 돌아간 단계",
      "items": {
        "type": "object",
        "required": ["attempt", "spec", "pass", "failed"],
        "properties": {
          "attempt": { "type": "integer", "minimum": 1 },
          "spec": { "type": "string" },
          "pass": { "type": "boolean" },
          "failed": { "type": "array", "items": { "type": "string" } },
          "patch": { "type": ["string", "null"] },
          "branch": { "type": ["string", "null"], "enum": ["build", "generate", "codegen", null] },
          "stop": { "type": ["string", "null"] },
          "build": { "type": ["string", "null"] },
          "duration_s": { "type": "number" }
        }
      }
    },
    "codegen": { "type": "object" },
    "roundtrip": { "type": ["object", "null"] },
    "fault": { "type": ["object", "null"], "description": "--inject-fault 로 깨뜨린 것(patches/000.json)" },
    "finalize": { "type": ["object", "null"], "description": "저장 · 폐기 결과" },
    "artifacts": { "type": "object", "description": "run 폴더 기준 상대 경로 — render.png · render_sample.png · geometry.json · lineage.json" },
    "verify": { "type": ["string", "null"], "enum": ["pass", "fail", null], "description": "마지막 verify 결과(돌지 않았으면 null)" },
    "message": { "type": "string" }
  }
}
